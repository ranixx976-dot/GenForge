# ==============================================================================
# GenForge Environment Configuration
# ==============================================================================

# Core Gemini API Key (Injected automatically in Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key"

# OpenAI-compatible / Gemini proxy fallback configuration
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
LLM_MODEL_BUILD="gemini-2.5-flash"
LLM_MODEL_ASK="gemini-2.5-flash"

# Scanner Service URL (FastAPI with CodeBERT model in scanner-service/)
# If unavailable or offline, the dual-signal scanner safely falls back to
# local AST/Pattern cross-check and embedded risk heuristic.
SCANNER_URL="http://localhost:8000"

# Web Search Provider (options: 'gemini_grounding', 'duckduckgo', 'tavily')
SEARCH_PROVIDER="gemini_grounding"
SEARCH_API_KEY=""

# Optional Vercel Token for 1-click deployment
VERCEL_TOKEN=""

# Server & Rate Limits
PORT=3000
RATE_LIMIT_PER_MINUTE=20
DAILY_GLOBAL_CAP=500

